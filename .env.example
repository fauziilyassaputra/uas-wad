APP_NAME="Inventaris Gudang"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Database MySQL (buat database kosong dengan nama di bawah sebelum menjalankan migrasi)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=uas_wad
DB_USERNAME=root
DB_PASSWORD=

# Session disimpan di database (tabel "sessions" dibuat oleh migrasi)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12

# --- Hanya untuk production / database cloud (kosongkan di lokal) ---
# Path sertifikat CA untuk koneksi SSL ke MySQL cloud (contoh: Aiven).
# MYSQL_ATTR_SSL_CA=/var/www/html/certs/aiven-ca.pem

# Password akun seeder. Di lokal boleh dikosongkan (seeder memakai "password").
# Di production WAJIB diisi dengan password yang kuat.
# SEED_ADMIN_PASSWORD=
# SEED_STAFF_PASSWORD=

# Production: APP_ENV=production, APP_DEBUG=false, APP_URL=https://..., SESSION_SECURE_COOKIE=true
